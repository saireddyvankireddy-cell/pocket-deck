# OAuth app credentials: configure on the server only.
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Generate 32 random bytes as 64 hex characters.
SAI_PHOTOS_SESSION_KEY=
# Must match the URL opened on your phone and the registered callback origin.
SAI_PHOTOS_ORIGIN=http://192.168.88.11:4173
# Home Wi-Fi preview only. Set false and use HTTPS for deployment.
SAI_PHOTOS_ALLOW_HTTP=true
PCLOUD_PHOTO_PATHS=/Pictures,/Automatic Upload,/Automatic Folder
PCLOUD_AUDIO_PATHS=/Music
